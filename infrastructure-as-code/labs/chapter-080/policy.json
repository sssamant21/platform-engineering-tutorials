{
  "schema_version": 1,
  "targets": {
    "environment": "lab",
    "aws_account": "offline-sandbox",
    "azure_subscription": "offline-sandbox",
    "gcp_project": "offline-sandbox",
    "kube_context": "offline-kind",
    "ansible_inventory": "localhost",
    "pulumi_stack": "dev",
    "terraform_workspace": "lab",
    "gitops_branch": "release/lab"
  },
  "required_controls": [
    "source_signed",
    "codeowners_reviewed",
    "toolchain_pinned",
    "sbom_reviewed",
    "oidc_scoped",
    "least_privilege",
    "targets_verified",
    "backend_encrypted",
    "backend_versioned",
    "state_lock_verified",
    "preview_reviewed",
    "artifact_digest_verified",
    "policy_enforced",
    "no_destroy",
    "no_stateful_replacement",
    "security_approved",
    "sre_approved",
    "dbre_approved",
    "backup_verified",
    "restore_rehearsed",
    "rpo_rto_defined",
    "quorum_reviewed",
    "fencing_reviewed",
    "gitops_ownership_verified",
    "canary_approved",
    "slo_healthy",
    "audit_immutable",
    "finops_reviewed"
  ],
  "require_exact_controls": true,
  "allowed_tools": [
    "terraform",
    "opentofu",
    "pulumi",
    "cloudformation",
    "bicep",
    "ansible",
    "kubernetes",
    "argocd",
    "flux"
  ]
}
