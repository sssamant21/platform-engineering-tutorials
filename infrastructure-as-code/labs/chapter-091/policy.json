{
  "schema_version": 1,
  "target": {
    "environment": "offline-observability-lab",
    "cloud_account": "offline",
    "kube_context": "offline-kind",
    "repository": "sssamant21/platform-engineering-tutorials",
    "source_commit": "0123456789abcdef",
    "owner": "sre-dbre-lab"
  },
  "required_controls": [
    "source_approved",
    "target_verified",
    "otel_collector_healthy",
    "prometheus_scrape_healthy",
    "logs_redacted",
    "traces_redacted",
    "audit_logs_enabled",
    "collector_tls_enforced",
    "exporter_authenticated",
    "metrics_cardinality_bounded",
    "metrics_fresh",
    "logs_fresh",
    "traces_fresh",
    "alert_routes_verified",
    "runbooks_linked",
    "slo_calculated",
    "burn_rate_reviewed",
    "error_budget_reviewed",
    "gitops_observed",
    "drift_observed",
    "policy_decisions_observed",
    "state_lock_observed",
    "provider_throttling_observed",
    "dbre_replication_observed",
    "dbre_backup_observed",
    "dbre_restore_rehearsed",
    "rpo_accepted",
    "rto_accepted",
    "slo_healthy",
    "retention_verified"
  ],
  "required_metrics": [
    "iac_pipeline_runs_total",
    "iac_pipeline_duration_seconds",
    "iac_plan_destructive_changes_total",
    "iac_state_lock_wait_seconds",
    "iac_policy_denials_total",
    "iac_drift_findings",
    "iac_drift_detection_age_seconds",
    "iac_gitops_reconcile_duration_seconds",
    "iac_resource_orphans",
    "iac_observability_export_failures_total",
    "iac_dbre_restore_duration_seconds",
    "iac_change_slo_breaches_total"
  ],
  "require_exact_controls": true,
  "max_critical_findings": 0,
  "max_telemetry_age_minutes": 5,
  "max_drift_age_minutes": 15,
  "max_export_failures": 0,
  "max_error_rate_percent": 1,
  "max_rpo_minutes": 15,
  "max_rto_minutes": 60
}
