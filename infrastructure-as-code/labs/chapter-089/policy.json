{
  "schema_version": 1,
  "target": {
    "environment": "offline-drift-lab",
    "repository": "sssamant21/platform-engineering-tutorials",
    "cloud_account": "offline",
    "kube_context": "offline-kind",
    "source_commit": "0123456789abcdef",
    "policy_version": "v1"
  },
  "required_controls": [
    "source_approved",
    "protected_branch",
    "artifact_digest_verified",
    "exact_cloud_target",
    "least_privilege_readonly",
    "observation_fresh",
    "inventory_complete",
    "terraform_refresh_reviewed",
    "opentofu_plan_reviewed",
    "pulumi_drift_checked",
    "cloudformation_drift_checked",
    "bicep_whatif_checked",
    "aws_config_enabled",
    "azure_policy_enabled",
    "gcp_org_policy_enabled",
    "kubernetes_admission_enforced",
    "gitops_revision_verified",
    "opa_enforced",
    "sentinel_enforced",
    "audit_logs_enabled",
    "evidence_hash_verified",
    "exceptions_unexpired",
    "exception_approver_independent",
    "no_auto_destroy",
    "dbre_approved",
    "backup_verified",
    "restore_rehearsed",
    "rpo_accepted",
    "rto_accepted",
    "slo_healthy"
  ],
  "require_exact_controls": true,
  "max_critical_findings": 0,
  "max_observation_age_minutes": 15,
  "max_exception_age_days": 30,
  "max_rpo_minutes": 15,
  "max_rto_minutes": 60
}
