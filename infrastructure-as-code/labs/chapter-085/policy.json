{
  "schema_version": 1,
  "target": {
    "environment": "lab",
    "aws_account": "offline",
    "azure_subscription": "offline",
    "gcp_project": "offline",
    "kube_context": "offline-kind",
    "repository": "sssamant21/platform-engineering-tutorials",
    "source_commit": "0123456789abcdef",
    "oidc_subject": "repo:sssamant21/platform-engineering-tutorials:ref:refs/heads/main"
  },
  "required_controls": [
    "signed_source",
    "protected_branch",
    "codeowners_reviewed",
    "oidc_exact_issuer",
    "oidc_exact_audience",
    "oidc_exact_subject",
    "short_lived_identity",
    "no_static_cloud_keys",
    "aws_iam_scoped",
    "azure_rbac_scoped",
    "gcp_wif_scoped",
    "cloud_org_guardrails",
    "k8s_namespace_rbac",
    "k8s_admission_enforced",
    "gitops_controller_scoped",
    "network_policy_enforced",
    "secrets_manager_used",
    "no_exposed_secrets",
    "scanner_database_fresh",
    "iac_scan_passed",
    "dependency_scan_passed",
    "sbom_verified",
    "provenance_verified",
    "artifact_digest_verified",
    "provider_lockfile_verified",
    "opa_policy_enforced",
    "sentinel_policy_verified",
    "state_encrypted",
    "state_versioned",
    "state_locked",
    "state_access_scoped",
    "kms_recovery_verified",
    "security_approved",
    "sre_approved",
    "dbre_approved",
    "backup_isolated",
    "restore_rehearsed",
    "slo_healthy",
    "audit_immutable",
    "exception_expiry_verified"
  ],
  "require_exact_controls": true,
  "max_critical_findings": 0,
  "max_exposed_secrets": 0,
  "max_destroy": 0,
  "max_replace": 0,
  "max_rpo_minutes": 15,
  "max_rto_minutes": 60
}
