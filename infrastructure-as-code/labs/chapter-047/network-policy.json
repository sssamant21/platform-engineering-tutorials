{
  "allowed_environments": [
    "dev",
    "staging",
    "prod"
  ],
  "allowed_regions": [
    "us-central1",
    "us-east1",
    "us-east4",
    "us-west1"
  ],
  "required_labels": [
    "environment",
    "managed-by",
    "owner"
