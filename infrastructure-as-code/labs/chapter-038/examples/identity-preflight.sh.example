#!/usr/bin/env bash
set -euo pipefail
: "${EXPECTED_AWS_ACCOUNT_ID:?set approved account ID}"
: "${AWS_PROFILE:?set approved profile}"
actual="$(aws sts get-caller-identity --query Account --output text)"
if [[ "$actual" != "$EXPECTED_AWS_ACCOUNT_ID" ]]; then
  echo "DENY: unexpected AWS account" >&2
  exit 1
fi
echo "PASS: caller identity account verified"
# This check does not prove least privilege or trust-policy safety.
