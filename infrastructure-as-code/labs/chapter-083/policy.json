{
  "schema_version": 1,
  "target": {
    "environment": "lab",
    "repository": "sssamant21/platform-engineering-tutorials",
    "branch": "main",
    "cloud_account": "offline",
    "kube_context": "offline-kind",
    "scanner_policy_version": "v1"
  },
  "required_controls": [
    "source_signed",
    "protected_branch",
    "scanner_version_pinned",
    "scanner_database_fresh",
    "iac_scan_passed",
    "secrets_scan_passed",
    "dependency_scan_passed",
    "container_scan_passed",
    "sbom_generated",
    "sbom_reviewed",
    "provenance_verified",
    "builder_identity_trusted",
    "artifact_digest_verified",
    "provider_lockfile_verified",
    "no_critical_vulnerabilities",
    "no_exposed_secrets",
    "exceptions_reviewed",
    "exceptions_not_expired",
    "state_encrypted",
    "state_access_scoped",
    "cloud_runtime_inventory",
    "drift_detection_enabled",
    "gitops_integrity",
    "oidc_scoped",
    "security_approved",
    "sre_approved",
    "dbre_approved",
    "backup_verified",
    "restore_rehearsed",
    "slo_healthy",
    "audit_retained"
  ],
  "require_exact_controls": true,
  "max_critical_findings": 0,
  "max_exposed_secrets": 0
}
