# Copy to .github/workflows/iac-ch034.yml after review.
name: iac-chapter-034-quality
on:
  pull_request:
    paths:
      - 'infrastructure-as-code/labs/chapter-034/**'
  workflow_dispatch:
permissions:
  contents: read
jobs:
  quality:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: infrastructure-as-code/labs/chapter-034
    steps:
      - uses: actions/checkout@v4
      # Pin actions to reviewed commit SHAs before production use.
      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: '1.7.5'
      - name: Offline quality gates
        run: bash run-preflight.sh
