{
  "schema_version": 1,
  "target": {
    "environment": "offline-slo-lab",
    "cloud_account": "offline",
    "kube_context": "offline-kind",
    "repository": "sssamant21/platform-engineering-tutorials",
    "source_commit": "0123456789abcdef",
    "owner": "sre-dbre-lab"
  },
  "required_controls": [
    "source_approved",
    "protected_branch",
    "immutable_artifact",
    "exact_target",
    "plan_digest_verified",
    "provider_audit_enabled",
    "otel_collector_healthy",
    "prometheus_scrape_fresh",
    "logs_redacted",
    "traces_redacted",
    "sli_denominator_valid",
    "slo_objective_approved",
    "error_budget_calculated",
    "burn_rate_calculated",
    "multi_window_alerts_enabled",
    "alert_route_verified",
    "paging_delivery_verified",
    "runbook_linked",
    "incident_commander_assigned",
    "canary_slo_verified",
    "deployment_gate_enabled",
    "no_auto_destroy",
    "rollback_independently_approved",
    "state_snapshot_preserved",
    "drift_fresh",
    "gitops_health_verified",
    "policy_enforced",
    "dbre_backup_verified",
    "dbre_restore_rehearsed",
    "rpo_accepted",
    "rto_accepted",
    "application_slo_healthy",
    "audit_retention_verified",
    "postmortem_owner_assigned"
  ],
  "require_exact_controls": true,
  "max_critical_findings": 0,
  "max_destructive_actions": 0,
  "max_missing_evidence": 0,
  "max_telemetry_age_minutes": 5,
  "max_alert_delivery_minutes": 5,
  "max_error_budget_consumed_percent": 100,
  "max_rpo_minutes": 15,
  "max_rto_minutes": 60
}
