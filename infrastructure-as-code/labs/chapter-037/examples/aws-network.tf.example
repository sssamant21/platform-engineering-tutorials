# Review-only AWS provider example; copy into a separate approved root.
# NAT gateways, EIPs, ALBs and endpoints can incur costs.
terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}
variable "region" { type = string }
variable "account_id" { type = string }
variable "vpc_cidr" { type = string }
variable "public_subnet_cidr" { type = string }
variable "az" { type = string }
provider "aws" {
  region = var.region
  allowed_account_ids = [var.account_id]
}
resource "aws_vpc" "example" {
  cidr_block = var.vpc_cidr
  enable_dns_support = true
  enable_dns_hostnames = true
  tags = { Name = "review-only-network" }
}
resource "aws_subnet" "public" {
  vpc_id = aws_vpc.example.id
  cidr_block = var.public_subnet_cidr
  availability_zone = var.az
  map_public_ip_on_launch = false
}
resource "aws_internet_gateway" "example" {
  vpc_id = aws_vpc.example.id
}
resource "aws_route_table" "public" {
  vpc_id = aws_vpc.example.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.example.id
  }
}
resource "aws_route_table_association" "public" {
  subnet_id = aws_subnet.public.id
  route_table_id = aws_route_table.public.id
}
resource "aws_security_group" "database" {
  name_prefix = "db-private-"
  description = "No public ingress; add reviewed SG-reference rules only"
  vpc_id = aws_vpc.example.id
}
# This is not a complete production network; add multi-AZ private subnets,
# NAT per AZ if needed, endpoint policies, NACLs, flow logs and IAM reviews.
