# REVIEW ONLY. Separate root. Verify pinned provider version and chart schema.
terraform {
  required_providers {
    helm = {
      source  = "hashicorp/helm"
      version = "~> 2.0"
    }
  }
}
variable "kubeconfig_path" { type = string }
variable "kube_context" { type = string }
variable "approved_chart_version" { type = string }
provider "helm" {
  kubernetes {
    config_path    = var.kubeconfig_path
    config_context = var.kube_context
  }
}
# Replace placeholders only after chart provenance, RBAC and hook review.
resource "helm_release" "sandbox" {
  name             = "platform-review"
  repository       = "https://charts.example.invalid"
  chart            = "review-chart"
  version          = var.approved_chart_version
  namespace        = "platform-sandbox"
  create_namespace = false
  atomic           = true
  wait             = true
  timeout          = 600
}
# Not deployable as-is. Never put Secret payloads in values/state.
