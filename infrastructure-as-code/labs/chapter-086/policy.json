{
  "schema_version": 1,
  "target": {
    "environment": "lab",
    "repository": "sssamant21/platform-engineering-tutorials",
    "cloud_account": "offline",
    "kube_context": "offline-kind",
    "source_commit": "0123456789abcdef",
    "policy_version": "v1"
  },
  "required_controls": [
    "source_signed",
    "protected_branch",
    "toolchain_pinned",
    "provider_lockfile_verified",
    "format_passed",
    "syntax_passed",
    "static_scan_passed",
    "secrets_scan_passed",
    "unit_tests_passed",
    "negative_tests_passed",
    "policy_tests_passed",
    "policy_enforced",
    "plan_reviewed",
    "no_destructive_actions",
    "target_verified",
    "artifact_digest_verified",
    "identity_scoped",
    "state_locked",
    "state_encrypted",
    "integration_tests_passed",
    "ephemeral_isolation",
    "cleanup_verified",
    "kubernetes_rbac_tested",
    "admission_tested",
    "gitops_reconciliation_tested",
    "dbre_approved",
    "backup_verified",
    "restore_rehearsed",
    "slo_healthy",
    "audit_retained"
  ],
  "require_exact_controls": true,
  "min_unit_tests": 20,
  "min_negative_tests": 10,
  "max_skipped_critical": 0,
  "max_destroy": 0,
  "max_replace": 0,
  "max_rpo_minutes": 15,
  "max_rto_minutes": 60
}
