# Review-only AzureRM example. Requires an approved separate root, secure backend,
# private endpoint/DNS and audit architecture before any live deployment.
terraform {
  required_providers {
    azurerm = { source = "hashicorp/azurerm", version = "~> 4.0" }
  }
}
variable "tenant_id" { type = string }
variable "subscription_id" { type = string }
variable "location" { type = string }
provider "azurerm" {
  features {}
  tenant_id = var.tenant_id
  subscription_id = var.subscription_id
}
resource "azurerm_resource_group" "security" {
  name = "rg-security-review-only"
  location = var.location
}
resource "azurerm_user_assigned_identity" "workload" {
  name = "id-workload-review-only"
  resource_group_name = azurerm_resource_group.security.name
  location = azurerm_resource_group.security.location
}
resource "azurerm_key_vault" "review" {
  name = "kv-review-placeholder-123"
  resource_group_name = azurerm_resource_group.security.name
  location = azurerm_resource_group.security.location
  tenant_id = var.tenant_id
  sku_name = "standard"
  enable_rbac_authorization = true
  purge_protection_enabled = true
  public_network_access_enabled = false
  soft_delete_retention_days = 90
}
# Private endpoints, DNS links, scoped RBAC, diagnostics, rotation policy,
# name uniqueness and access recovery MUST be designed before apply.
# Never place production secret values in Terraform resources or variables.
