{
  "schema_version": 1,
  "target": {
    "environment": "offline-compliance-lab",
    "repository": "sssamant21/platform-engineering-tutorials",
    "cloud_account": "offline",
    "kube_context": "offline-kind",
    "source_commit": "0123456789abcdef",
    "audit_period": "2026-Q4"
  },
  "required_control_ids": [
    "IAC-001",
    "IAC-002",
    "IAC-003",
    "IAC-004",
    "IAC-005",
    "IAC-006",
    "IAC-007",
    "IAC-008"
  ],
  "required_controls": [
    "source_approved",
    "protected_branch",
    "artifact_digest_verified",
    "oidc_scoped",
    "cloud_iam_least_privilege",
    "state_encrypted",
    "state_versioned",
    "secrets_scanned",
    "opa_enforced",
    "sentinel_enforced",
    "cloud_org_policy_enforced",
    "kubernetes_admission_enforced",
    "gitops_scoped",
    "audit_logs_enabled",
    "audit_retention_verified",
    "evidence_immutable",
    "evidence_hashes_verified",
    "sbom_verified",
    "provenance_verified",
    "scanner_fresh",
    "policy_bundle_pinned",
    "exception_owner_verified",
    "exception_approver_independent",
    "exception_expiry_verified",
    "backup_encrypted",
    "restore_rehearsed",
    "kms_decrypt_verified",
    "rpo_accepted",
    "rto_accepted",
    "slo_healthy",
    "dbre_approved",
    "security_approved"
  ],
  "require_exact_controls": true,
  "max_critical_findings": 0,
  "max_exception_age_days": 30,
  "max_evidence_age_hours": 24,
  "max_rpo_minutes": 15,
  "max_rto_minutes": 60
}
