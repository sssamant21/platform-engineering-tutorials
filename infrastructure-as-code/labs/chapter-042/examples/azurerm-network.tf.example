# Review-only AzureRM example: copy to an approved separate Terraform root.
# Private DNS zones, peering, firewall and PaaS private endpoints need further design.
terraform {
  required_providers {
    azurerm = { source = "hashicorp/azurerm", version = "~> 4.0" }
  }
}
variable "subscription_id" { type = string }
variable "tenant_id" { type = string }
variable "location" { type = string }
variable "vnet_cidr" { type = string }
variable "app_subnet_cidr" { type = string }
provider "azurerm" {
  features {}
  subscription_id = var.subscription_id
  tenant_id = var.tenant_id
}
resource "azurerm_resource_group" "network" {
  name = "rg-network-review-only"
  location = var.location
}
resource "azurerm_virtual_network" "review" {
  name = "vnet-review-only"
  address_space = [var.vnet_cidr]
  location = azurerm_resource_group.network.location
  resource_group_name = azurerm_resource_group.network.name
}
resource "azurerm_subnet" "app" {
  name = "snet-app"
  resource_group_name = azurerm_resource_group.network.name
  virtual_network_name = azurerm_virtual_network.review.name
  address_prefixes = [var.app_subnet_cidr]
}
resource "azurerm_network_security_group" "app" {
  name = "nsg-app"
  location = azurerm_resource_group.network.location
  resource_group_name = azurerm_resource_group.network.name
}
resource "azurerm_subnet_network_security_group_association" "app" {
  subnet_id = azurerm_subnet.app.id
  network_security_group_id = azurerm_network_security_group.app.id
}
# In production, define reviewed explicit allow/deny rules, route tables,
# diagnostic settings and Private Link/DNS before applying.
