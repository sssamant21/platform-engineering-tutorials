{
  "schema_version": 1,
  "target": {
    "environment": "offline-capstone-lab",
    "cloud_account": "offline",
    "kube_context": "offline-kind",
    "repository": "sssamant21/platform-engineering-tutorials",
    "source_commit": "0123456789abcdef",
    "owner": "sre-dbre-lab"
  },
  "required_controls": [
    "source_approved",
    "protected_branch",
    "immutable_plan",
    "target_verified",
    "state_version_preserved",
    "read_only_inventory",
    "inventory_complete",
    "inventory_fresh",
    "aws_audit_healthy",
    "azure_audit_healthy",
    "gcp_audit_healthy",
    "otel_collector_healthy",
    "prometheus_scrape_fresh",
    "metrics_cardinality_bounded",
    "logs_redacted",
    "traces_redacted",
    "gitops_revision_verified",
    "drift_three_way_reviewed",
    "change_ticket_verified",
    "incident_timeline_utc",
    "alternative_causes_reviewed",
    "sli_denominator_valid",
    "error_budget_verified",
    "multi_window_alerts_verified",
    "paging_delivery_verified",
    "incident_commander_assigned",
    "no_auto_destroy",
    "rollback_approved",
    "dbre_backup_verified",
    "dbre_restore_rehearsed",
    "rpo_accepted",
    "rto_accepted",
    "application_slo_healthy",
    "data_integrity_verified",
    "audit_evidence_retained",
    "cleanup_zero_orphans"
  ],
  "require_exact_controls": true,
  "max_critical_findings": 0,
  "max_destructive_actions": 0,
  "max_missing_evidence": 0,
  "max_inventory_age_minutes": 15,
  "max_telemetry_age_minutes": 5,
  "max_error_budget_consumed_percent": 100,
  "max_rpo_minutes": 15,
  "max_rto_minutes": 60,
  "max_orphan_resources": 0
}
