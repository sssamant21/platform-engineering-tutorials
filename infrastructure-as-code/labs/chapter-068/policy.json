{
  "allowed_environments": [
    "lab",
    "dev"
  ],
  "required_labels": [
    "environment",
    "managed-by",
    "owner"
  ],
  "required_controls": {
    "architecture": [
      "arm_scope_reviewed",
      "module_contract_reviewed",
      "dependencies_reviewed",
      "api_versions_reviewed",
      "output_secrets_denied"
    ],
    "deployment": [
      "what_if_reviewed",
      "incremental_mode",
      "target_subscription_verified",
      "resource_group_verified",
      "rollback_documented",
      "destructive_change"
    ],
    "security": [
      "least_privilege",
      "federated_identity",
      "azure_policy_reviewed",
      "tls_enforced",
      "public_blob_denied",
      "secrets_external"
    ],
    "dbre": [
      "backup_verified",
      "restore_rehearsed",
      "dbre_approved",
      "slo_reviewed",
      "quorum_reviewed"
    ],
    "governance": [
      "change_approved",
      "owner_verified",
      "audit_enabled",
      "module_pinned",
      "cost_reviewed"
    ]
  },
  "forbidden_controls": {
    "deployment": [
      "destructive_change"
    ]
  },
  "require_ticket": true,
  "deny_prod_targets": true,
  "require_what_if": true,
  "require_scope_review": true,
  "require_dbre_backup": true,
  "require_approval": true
}
