# Illustrative only. Terraform >=1.10 for native S3 use_lockfile.
# Prepare a private, versioned, encrypted bucket and scoped IAM first.
terraform {
  backend "s3" {
    bucket       = "REPLACE-approved-state-bucket"
    key          = "iac/prod/database/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}
