# REVIEW ONLY — replace bucket and credentials with approved sandbox.
locals {
  environment = "dev"
  account = "sandbox"
  region = "us-east-1"
}
remote_state {
  backend = "s3"
  config = {
    bucket = "REPLACE-WITH-APPROVED-BUCKET"
    key = "iac/${local.environment}/${local.account}/${local.region}/network.tfstate"
    region = local.region
    encrypt = true
    use_lockfile = true
  }
}
