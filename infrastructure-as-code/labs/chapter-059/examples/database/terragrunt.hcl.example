# REVIEW ONLY — do not mock dependency outputs during production apply.
include "root" {
  path = find_in_parent_folders("root.hcl")
}
terraform {
  source = "git::https://example.invalid/platform/modules.git//database?ref=REPLACE-WITH-SHA"
}
dependency "network" {
  config_path = "../network"
}
inputs = {
  private_subnets = dependency.network.outputs.private_subnet_ids
  deletion_protection = true
}
