{
  "schema_version": 1,
  "target": {
    "environment": "offline-incident-lab",
    "cloud_account": "offline",
    "kube_context": "offline-kind",
    "repository": "sssamant21/platform-engineering-tutorials",
    "source_commit": "0123456789abcdef",
    "owner": "sre-dbre-lab"
  },
  "required_controls": [
    "source_approved",
    "protected_branch",
    "immutable_artifact",
    "exact_target",
    "change_ticket_verified",
    "actor_identity_verified",
    "plan_digest_verified",
    "provider_audit_enabled",
    "cloud_inventory_complete",
    "otel_traces_present",
    "prometheus_metrics_fresh",
    "gitops_health_observed",
    "policy_enforced",
    "state_snapshot_preserved",
    "event_time_utc",
    "clock_skew_bounded",
    "trace_context_propagated",
    "slo_burn_rate_checked",
    "error_budget_reviewed",
    "incident_commander_assigned",
    "blast_radius_documented",
    "alternative_hypotheses_reviewed",
    "no_automatic_causal_claim",
    "no_auto_destroy",
    "rollback_approved",
    "dbre_backup_verified",
    "dbre_restore_rehearsed",
    "rpo_accepted",
    "rto_accepted",
    "slo_healthy",
    "evidence_retained",
    "postmortem_owner_assigned"
  ],
  "require_exact_controls": true,
  "max_critical_findings": 0,
  "max_destructive_actions": 0,
  "max_missing_evidence": 0,
  "max_event_age_minutes": 15,
  "max_clock_skew_seconds": 30,
  "max_change_failure_rate_percent": 10,
  "max_rpo_minutes": 15,
  "max_rto_minutes": 60
}
