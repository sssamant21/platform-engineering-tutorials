{
  "schema_version": 1,
  "target": {
    "environment": "offline-drift-observability-lab",
    "cloud_account": "offline",
    "kube_context": "offline-kind",
    "repository": "sssamant21/platform-engineering-tutorials",
    "source_commit": "0123456789abcdef",
    "owner": "sre-dbre-lab"
  },
  "required_controls": [
    "source_approved",
    "protected_branch",
    "immutable_artifact",
    "exact_target",
    "read_only_scanner",
    "inventory_complete",
    "inventory_fresh",
    "state_version_preserved",
    "terraform_refresh_reviewed",
    "opentofu_refresh_reviewed",
    "pulumi_preview_reviewed",
    "cloudformation_drift_reviewed",
    "bicep_whatif_reviewed",
    "aws_config_checked",
    "azure_resource_graph_checked",
    "gcp_asset_inventory_checked",
    "kubernetes_diff_reviewed",
    "gitops_revision_verified",
    "opa_policy_enforced",
    "sentinel_policy_enforced",
    "change_ticket_verified",
    "actor_identity_verified",
    "exception_independently_approved",
    "no_auto_destroy",
    "remediation_requires_review",
    "audit_logs_enabled",
    "evidence_integrity_verified",
    "dbre_backup_verified",
    "dbre_restore_rehearsed",
    "rpo_accepted",
    "rto_accepted",
    "slo_healthy"
  ],
  "require_exact_controls": true,
  "max_critical_findings": 0,
  "max_destructive_actions": 0,
  "max_missing_evidence": 0,
  "max_snapshot_age_minutes": 15,
  "min_inventory_coverage_percent": 99,
  "max_detection_latency_minutes": 15,
  "max_rpo_minutes": 15,
  "max_rto_minutes": 60
}
